# 자료 → 카드 자동 생성 (Mode B). 운영자가 발급하는 키.
# https://console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# 배포 URL (OG/canonical absolute URL + manifest 기준).
# 보통 설정 불필요 — lib/site-url.ts 가 배포 컨텍스트(VERCEL_ENV/VERCEL_GIT_COMMIT_REF)로
# 공개 도메인을 자동 매핑한다: production→games.pullim.ai, dev 브랜치→dev-games.pullim.ai,
# PR preview→자기 배포 호스트. 특정 호스트를 강제할 때만 아래 override 사용.
# NEXT_PUBLIC_SITE_URL=https://games.pullim.ai

# 계정(로그인/회원가입) DB — proc/plan/2026-05-29_auth-login-signup.md.
# dev: docker compose up -d db (포트 5436). prod: games 전용 Supabase URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/games

# auth/sync 라우트 same-origin 가드의 허용 origin. 요청 자신의 Host 는 항상 허용되고
# VERCEL_URL 도 자동 허용(same-origin.ts) → Preview/dev 는 추가 설정 없이 동작.
# 커스텀 도메인 보강:
#   - Production  → NEXT_PUBLIC_SITE_ORIGIN=https://games.pullim.ai
#   - Preview     → 미설정 (Host + VERCEL_URL 로 충분. dev-games.pullim.ai 는 자기 Host 로 허용)
# NEXT_PUBLIC_SITE_ORIGIN=https://games.pullim.ai

# activity_log 14일 retention cron(/api/sync/cleanup) 인증. Vercel 이 Bearer 로 동봉.
CRON_SECRET=

# 통합 로그인(SSO) — pullim-web/pullim-api 중앙 인증 위임(spec/05 §5.2·spec/09 §9.4).
# ⚠️ 두 값은 all-or-nothing: 둘 다 설정=pullim 모드(회원 신원 SSO 위임), 둘 다 미설정=legacy
# (games 자체 이메일+비번 auth). 한쪽만 설정하면 부팅 fail-fast(lib/auth/pullim-mode.ts).
# ⚠️ 활성화(env 설정) 전 hard precondition — plan §2-D: /games/me 가 grade+표시명 제공,
#    기존 legacy 회원 재연결 규칙, 중앙 삭제 파기 전파. 미충족 상태 활성화 금지.
# pullim-api base(회원 세션 introspection /games/me·직접 호출):
#   dev=https://dev-api.pullim.ai · prod=https://api.pullim.ai · 로컬 SSO=http://api.pullim.local:<port>
# NEXT_PUBLIC_DOMAIN_API_URL=
# 미인증 회원 리다이렉트 대상 = SITE 호스트(OS 호스트 아님):
#   dev=https://dev.pullim.ai · prod=https://pullim.ai · 로컬 SSO=http://pullim.local:3001
# NEXT_PUBLIC_PULLIM_LOGIN_ORIGIN=
# ⚠️ 로컬 SSO 검증(games.pullim.local:3004) 시엔 NEXT_PUBLIC_SITE_URL 도 설정 필요 — AuthCta 의
#   no-JS 폴백 href 가 SSR 에서 실제 호스트로 복귀 next 를 만들려면(서버 페이지 direct-hit 는
#   headers() 로 자동 정확). 예: NEXT_PUBLIC_SITE_URL=http://games.pullim.local:3004 (spec/09 §9.4).
