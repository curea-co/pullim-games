# 자료 → 카드 자동 생성 (Mode B). 운영자가 발급하는 키.
# https://console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# 배포 URL — OG/Twitter 카드의 absolute URL 해석 + manifest 기준.
# 환경별로 Vercel 에 설정 (Production/Preview 분리):
#   - production (main 브랜치)  → https://games.pullim.ai
#   - dev/preview (dev 브랜치)  → https://dev-games.pullim.ai
# 미설정 시 코드 폴백(games.pullim.ai)으로 동작.
NEXT_PUBLIC_SITE_URL=https://games.pullim.ai

# 계정(로그인/회원가입) DB — proc/plan/2026-05-29_auth-login-signup.md.
# dev: docker compose up -d db (포트 5436). prod: games 전용 Supabase URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/games

# auth/sync 라우트 same-origin 가드의 허용 origin. 요청 자신의 Host 는 항상 허용되지만
# (same-origin.ts), 커스텀 도메인 운영에서는 명시 설정이 안전. 환경별로 Vercel 에 설정:
#   - production (main)  → https://games.pullim.ai
#   - dev/preview (dev)  → https://dev-games.pullim.ai
# (Vercel preview 자동 도메인은 VERCEL_URL 로 자동 해소.)
# NEXT_PUBLIC_SITE_ORIGIN=https://games.pullim.ai

# activity_log 14일 retention cron(/api/sync/cleanup) 인증. Vercel 이 Bearer 로 동봉.
CRON_SECRET=
