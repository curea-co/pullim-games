# 자료 → 카드 자동 생성 (Mode B). 운영자가 발급하는 키.
# https://console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# 배포 URL — OG/Twitter 카드의 absolute URL 해석 + manifest 기준.
# Vercel 배포 도메인. 미설정 시 코드 폴백으로 동작.
NEXT_PUBLIC_SITE_URL=https://pullim-games.vercel.app

# 계정(로그인/회원가입) DB — proc/plan/2026-05-29_auth-login-signup.md.
# dev: docker compose up -d db (포트 5436). prod: games 전용 Supabase URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/games

# auth 라우트 same-origin 가드의 허용 origin. Vercel 기본 도메인이면 VERCEL_URL 로
# 자동 해소되지만, 커스텀 도메인/프록시 배포에서는 반드시 설정해야 로그인·회원가입
# POST 가 403(forbidden_origin) 으로 막히지 않는다. 예: https://games.pullim.app
# NEXT_PUBLIC_SITE_ORIGIN=https://games.pullim.app
