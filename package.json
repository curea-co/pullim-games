{
  "name": "pullim-games-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:games": "bun --filter @pullim-games/games dev",
    "build": "turbo build",
    "build:games": "bun --filter @pullim-games/games build",
    "start": "bun --filter @pullim-games/games start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "gen:registry": "bun --filter @pullim-games/games gen:registry",
    "test:e2e": "bun --filter @pullim-games/games test:e2e",
    "test:e2e:ui": "bun --filter @pullim-games/games test:e2e:ui",
    "ui:audit": "bun --filter @pullim-games/games ui:audit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d"
  },
  "devDependencies": {
    "turbo": "^2.7.4",
    "typescript": "^5.6.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "packageManager": "bun@1.3.12"
}
